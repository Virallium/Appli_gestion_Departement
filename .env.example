# Variables d'environnement pour le déploiement
# Copiez ce fichier vers .env et remplissez les valeurs

# Clé secrète Django (générez-en une nouvelle pour la production)
SECRET_KEY=django-insecure-change-me-in-production

# Mode debug (False en production)
DEBUG=False

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# URL de la base de données PostgreSQL
# Pour Render: postgres://user:password@host:5432/dbname
# Pour Supabase: votre URL Supabase existante
DATABASE_URL=postgresql://user:password@localhost:5432/dbname